# Normalise to LF in the repository; check out with the platform default.
* text=auto

# Sources and scripts are always LF so the shell/Python tooling keeps working
# after a fresh clone on Windows.
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.cs    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.proto text eol=lf
*.md    text eol=lf

# Vendored archives and generated goldens must never be re-encoded.
*.tar.gz binary
*.tar.xz binary
*.png    binary
*.ico    binary
*.zip    binary

# Oracle fixtures are transcribed output: pin them to LF so a checkout on any
# platform yields the bytes the tests compare against.
tests/goldens/** text eol=lf
