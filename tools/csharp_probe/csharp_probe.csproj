<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>csharp_probe</AssemblyName>
    <RootNamespace>csharp_probe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same package and version Lively.Common uses: the package-detection oracle
         writes archives with the real SharpZipLib so the port's zip reader is
         compared against the library upstream actually calls. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <ProjectReference Include="..\..\..\lively in C#\src\Lively\Lively.Models\Lively.Models.csproj" />
    <ProjectReference Include="..\..\..\lively in C#\src\Lively\Lively.Common\Lively.Common.csproj" />
    <ProjectReference Include="..\..\..\lively in C#\src\Lively\Lively.Grpc.Common\Lively.Grpc.Common.csproj" />
  </ItemGroup>

</Project>
